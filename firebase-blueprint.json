{
  "entities": {
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website configuration including business contact details, hero text, and JSON-serialized sections managed from the Admin Panel.",
      "type": "object",
      "properties": {
        "businessName": {
          "type": "string",
          "description": "Official business name",
          "minLength": 1,
          "maxLength": 120
        },
        "tagline": {
          "type": "string",
          "description": "Business tagline",
          "minLength": 1,
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "description": "Display phone number",
          "minLength": 5,
          "maxLength": 40
        },
        "whatsappNumber": {
          "type": "string",
          "description": "Digits-only WhatsApp number for wa.me links",
          "minLength": 8,
          "maxLength": 20,
          "pattern": "^[0-9]+$"
        },
        "email": {
          "type": "string",
          "description": "Official business email",
          "minLength": 5,
          "maxLength": 120
        },
        "addressFull": {
          "type": "string",
          "description": "Full postal address",
          "minLength": 5,
          "maxLength": 300
        },
        "instagramUrl": {
          "type": "string",
          "description": "Instagram profile URL",
          "minLength": 5,
          "maxLength": 500
        },
        "logoPath": {
          "type": "string",
          "description": "Path or URL to the brand logo",
          "minLength": 1,
          "maxLength": 500
        },
        "heroBadge": {
          "type": "string",
          "description": "Top pill badge text on the home hero",
          "minLength": 1,
          "maxLength": 150
        },
        "heroTitle": {
          "type": "string",
          "description": "Main hero headline text",
          "minLength": 1,
          "maxLength": 200
        },
        "heroAccent": {
          "type": "string",
          "description": "Highlighted accent phrase in the hero headline",
          "minLength": 1,
          "maxLength": 100
        },
        "heroSubtitle": {
          "type": "string",
          "description": "Hero subheadline paragraph",
          "minLength": 1,
          "maxLength": 600
        },
        "updatedBy": {
          "type": "string",
          "description": "UID of the admin who updated the settings",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last update"
        }
      },
      "required": [
        "businessName",
        "tagline",
        "phone",
        "whatsappNumber",
        "email",
        "addressFull",
        "instagramUrl",
        "logoPath",
        "heroBadge",
        "heroTitle",
        "heroAccent",
        "heroSubtitle",
        "updatedBy",
        "updatedAt"
      ]
    },
    "CatalogueProduct": {
      "title": "CatalogueProduct",
      "description": "Audio-visual rental product item in the LIVEON CONNECT catalogue.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product identifier slug",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Product display name",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "Equipment category",
          "enum": [
            "Sound Systems",
            "Lighting",
            "LED Walls",
            "TVs & Displays",
            "Projectors",
            "Mixers & Mics",
            "AV Accessories",
            "Special Effects",
            "Genset"
          ]
        },
        "description": {
          "type": "string",
          "description": "Product description and usage notes",
          "minLength": 1,
          "maxLength": 1000
        },
        "imagePath": {
          "type": "string",
          "description": "Product photo path or URL",
          "minLength": 1,
          "maxLength": 2000
        },
        "minPrice": {
          "type": "number",
          "description": "Minimum indicative rental price in INR"
        },
        "maxPrice": {
          "type": "number",
          "description": "Maximum indicative rental price in INR"
        },
        "pricingUnit": {
          "type": "string",
          "description": "Billing unit code",
          "enum": ["day", "sq_ft", "5_hours"]
        },
        "pricingUnitLabel": {
          "type": "string",
          "description": "Human-readable billing unit label",
          "minLength": 1,
          "maxLength": 40
        },
        "availabilityStatus": {
          "type": "string",
          "description": "Availability status label",
          "enum": ["Subject to Confirmation", "Available on Request"]
        },
        "requestQuoteOnly": {
          "type": "boolean",
          "description": "Whether price is hidden in favor of Request a Quote"
        },
        "featured": {
          "type": "boolean",
          "description": "Whether product is featured on the home page"
        },
        "packageLabel": {
          "type": "string",
          "description": "Optional package subtitle",
          "maxLength": 160
        },
        "subGroup": {
          "type": "string",
          "description": "Optional sub-group name",
          "maxLength": 100
        },
        "badge": {
          "type": "string",
          "description": "Optional highlight badge",
          "maxLength": 80
        },
        "technicalSpecs": {
          "type": "array",
          "description": "Bounded list of up to 10 technical specification strings"
        },
        "eventTags": {
          "type": "array",
          "description": "Bounded list of up to 4 event tags"
        },
        "updatedBy": {
          "type": "string",
          "description": "Admin UID who last modified this product",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last modification"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "description",
        "imagePath",
        "minPrice",
        "maxPrice",
        "pricingUnit",
        "pricingUnitLabel",
        "availabilityStatus",
        "requestQuoteOnly",
        "featured",
        "technicalSpecs",
        "eventTags",
        "updatedBy",
        "updatedAt"
      ]
    },
    "MediaItem": {
      "title": "MediaItem",
      "description": "Hero video, live production video reel, or field production gallery photo managed via Admin Panel.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique media item ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mediaType": {
          "type": "string",
          "description": "Section where this media item is displayed",
          "enum": ["hero_video", "production_video", "field_photo"]
        },
        "title": {
          "type": "string",
          "description": "Display title of the video or photo",
          "minLength": 1,
          "maxLength": 200
        },
        "categoryOrTag": {
          "type": "string",
          "description": "Category badge or video number tag",
          "minLength": 1,
          "maxLength": 120
        },
        "caption": {
          "type": "string",
          "description": "Detailed technical caption",
          "minLength": 1,
          "maxLength": 600
        },
        "src": {
          "type": "string",
          "description": "Path or URL to the video or photo asset",
          "minLength": 1,
          "maxLength": 2000
        },
        "poster": {
          "type": "string",
          "description": "Poster thumbnail URL for videos",
          "maxLength": 2000
        },
        "span": {
          "type": "string",
          "description": "Responsive Tailwind grid span class",
          "minLength": 1,
          "maxLength": 60
        },
        "sortOrder": {
          "type": "number",
          "description": "Display ordering index (0 or greater)"
        },
        "updatedBy": {
          "type": "string",
          "description": "Admin UID who updated the media item",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": [
        "id",
        "mediaType",
        "title",
        "categoryOrTag",
        "caption",
        "src",
        "poster",
        "span",
        "sortOrder",
        "updatedBy",
        "updatedAt"
      ]
    },
    "QuoteEnquiry": {
      "title": "QuoteEnquiry",
      "description": "Customer rental quote or contact enquiry logged for admin tracking.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Enquiry document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name",
          "minLength": 1,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer phone or WhatsApp number (PII - Admin only)",
          "minLength": 5,
          "maxLength": 40
        },
        "customerEmail": {
          "type": "string",
          "description": "Customer email address (PII - Admin only)",
          "maxLength": 120
        },
        "eventType": {
          "type": "string",
          "description": "Type of event",
          "minLength": 1,
          "maxLength": 120
        },
        "eventDate": {
          "type": "string",
          "description": "Requested event date",
          "maxLength": 60
        },
        "venue": {
          "type": "string",
          "description": "Event venue location",
          "maxLength": 200
        },
        "equipmentSummary": {
          "type": "string",
          "description": "Summary of requested equipment items",
          "minLength": 1,
          "maxLength": 4000
        },
        "estimatedTotal": {
          "type": "string",
          "description": "Indicative cost range string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "description": "Enquiry workflow status",
          "enum": ["new", "contacted", "confirmed", "archived"]
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the user who created the enquiry",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": [
        "id",
        "customerName",
        "customerPhone",
        "customerEmail",
        "eventType",
        "eventDate",
        "venue",
        "equipmentSummary",
        "estimatedTotal",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Trusted administrator record for RBAC lookup.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Verified email address of the administrator",
          "minLength": 5,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable creation timestamp"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/siteConfig/{configId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global site configuration documents (e.g. /siteConfig/main). Publicly readable by ID, writable only by verified Admin."
    },
    "/catalogueProducts/{productId}": {
      "schema": { "$ref": "#/entities/CatalogueProduct" },
      "description": "Equipment rental catalogue items. Publicly readable, writable only by verified Admin."
    },
    "/mediaItems/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaItem" },
      "description": "Hero videos, live production videos, and field gallery photos. Publicly readable, writable only by verified Admin."
    },
    "/quoteEnquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/QuoteEnquiry" },
      "description": "Customer quote and contact enquiries containing PII. Readable and manageable strictly by verified Admin or creator."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Administrator registry for RBAC verification."
    }
  }
}
